typeset -U path PATH

[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

export MISE_GITHUB_CREDENTIAL_COMMAND='gh auth token --hostname "$MISE_CREDENTIAL_HOST"'

# Shims go last: `mise activate` (omz plugin) prepends the real tool paths in
# .zshrc and must win. Shims stay as a fallback for non-interactive/GUI shells.
path=("$HOME/.local/bin" $path "$HOME/.local/share/mise/shims")
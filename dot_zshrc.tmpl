# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="$HOME/.config/zsh/custom"

# Handled by starship
ZSH_THEME=""

# chezmoi owns updates
zstyle ':omz:update' mode disabled

HIST_STAMPS="yyyy-mm-dd"

plugins=(
{{- if eq .chezmoi.os "linux" }}
  dnf
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
  brew
{{- end }}
  aliases
  git
  zsh-autosuggestions
  zsh-bat
  mise
  zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

# ~/Code/provider.com/username/repo
gclone() {
  [[ -z "${1:-}" ]] && { echo "Usage: gclone <repo-url>"; return 1; }
  local url="${1%/}"
  local stripped="${url#*://}"
  stripped="${stripped#git@}"
  stripped="${stripped/://}"
  stripped="${stripped%.git}"
  local dest="$HOME/Code/$stripped"
  mkdir -p "${dest:h}"
  git clone -- "$url" "$dest" && cd "$dest"
}

# `mise use -g` writes to a chezmoi-managed file; sync it back to the source.
mise-add() {
  mise use -g "$@" && chezmoi re-add ~/.config/mise/config.toml
}

# command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh --cmd cd)"
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
# https://starship.rs/guide/#%F0%9F%9A%80-installation
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
